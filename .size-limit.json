[
  {
    "name": "Initial JS (gzipped) \u2014 first-paint UI, form affordances, paste import, and the step rail (quick-fill sample records load on demand)",
    "path": "dist/assets/index-*.js",
    "limit": "48 KB",
    "gzip": true
  },
  {
    "name": "React vendor (gzipped)",
    "path": "dist/assets/react-*.js",
    "limit": "75 KB",
    "gzip": true
  },
  {
    "name": "Barcode renderer (bwip-js, gzipped)",
    "path": "dist/assets/barcode-*.js",
    "limit": "260 KB",
    "gzip": true
  },
  {
    "name": "Scanner (zxing, gzipped)",
    "path": "dist/assets/scanner-*.js",
    "limit": "130 KB",
    "gzip": true
  },
  {
    "name": "PDF export (jspdf, gzipped)",
    "path": "dist/assets/export-*.js",
    "limit": "150 KB",
    "gzip": true
  },
  {
    "name": "Total CSS (gzipped)",
    "path": "dist/assets/*.css",
    "limit": "20 KB",
    "gzip": true
  },
  {
    "name": "Self-hosted fonts (woff2, already compressed) \u2014 both variable faces, latin subset",
    "path": "dist/assets/*.woff2",
    "limit": "80 KB",
    "gzip": false
  }
]
